#!/usr/bin/env python3

import subprocess
import socket
import argparse
import csv
import os
import requests
import re
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed

# ==============================
# DEBUG HELPER
# ==============================

def debug(msg):  # DEBUG
    print(f"[DEBUG] {msg}")  # DEBUG

# ==============================
# CONFIG
# ==============================

FAST_TOOLS = [
    ("subfinder", ["subfinder", "-silent", "-d"]),
    ("assetfinder", ["assetfinder", "--subs-only"]),
    ("findomain", ["findomain", "-q", "-t"])
]

DEEP_TOOLS = [
    ("amass", ["amass", "enum", "-passive", "-norecursive", "-d"])
]

COMMON_TLDS = [
    "com","net","org","co","io","in","ai","app","tech","cloud"
]

PREFIX_PATTERNS = ["get","join","try","my","secure"]
SUFFIX_PATTERNS = ["group","corp","global","cloud","tech","services"]

TIMEOUT = 8
MAX_WORKERS = 40

KNOWN_DOMAINS_FILE = "known_domains.csv"

# ==============================
# DOMAIN REGISTRY
# ==============================

domain_registry = {}
source_stats = {}

def add_domain(domain, source, seed):

    domain = normalize_domain(domain)

    if not domain or "." not in domain:
        return

    source_stats[source] = source_stats.get(source, 0) + 1

    if domain not in domain_registry:

        domain_registry[domain] = {
            "sources": set(),
            "seeds": set(),
            "ip": "",
            "reverse_dns": "",
            "http_status": "",
            "http_reason": "",
            "redirect_location": "",
            "final_url": "",
            "final_status": "",
            "title": ""
        }

    domain_registry[domain]["sources"].add(source)
    domain_registry[domain]["seeds"].add(seed)


# ==============================
# HELPERS
# ==============================

def normalize_domain(d):

    d = (d or "").strip().lower()
    d = d.replace("https://","").replace("http://","")
    d = d.split("/")[0]
    return d


def run_tool(cmd):

    debug(f"Executing tool: {' '.join(cmd)}")  # DEBUG

    try:
        result = subprocess.run(cmd, capture_output=True, text=True)

        lines = result.stdout.splitlines()

        debug(f"Tool finished: {' '.join(cmd)} | results: {len(lines)}")  # DEBUG

        return lines
    except Exception as e:

        debug(f"Tool failed: {' '.join(cmd)} | error: {e}")  # DEBUG

        return []


def extract_brand(seed):

    brand = seed.split(".")[0]
    brand = brand.replace("-","")
    return brand.lower()


# ==============================
# ENUMERATION
# ==============================

def run_subdomain_enum(seed, deep):

    tools = FAST_TOOLS.copy()
    if deep:
        tools += DEEP_TOOLS

    for name, cmd in tools:

        print(f"[+] Running {name} on {seed}")

        debug(f"Starting tool {name} for seed {seed}")  # DEBUG

        results = run_tool(cmd + [seed])

        debug(f"{name} discovered {len(results)} domains")  # DEBUG

        for d in results:
            add_domain(d, name, seed)


# ==============================
# BRAND EXPANSION
# ==============================

def brand_expand(seed):

    debug(f"Running brand expansion for {seed}")  # DEBUG

    brand = extract_brand(seed)

    for tld in COMMON_TLDS:

        d = f"{brand}.{tld}"
        add_domain(d, "brand_tld", seed)

    for p in PREFIX_PATTERNS:

        d = f"{p}{brand}.com"
        add_domain(d, "brand_pattern", seed)

        d2 = f"{p}-{brand}.com"
        add_domain(d2, "brand_pattern", seed)

    for s in SUFFIX_PATTERNS:

        d = f"{brand}{s}.com"
        add_domain(d, "brand_pattern", seed)

        d2 = f"{brand}-{s}.com"
        add_domain(d2, "brand_pattern", seed)

    debug(f"Brand expansion completed for {seed}")  # DEBUG


# ==============================
# CT EXPANSION
# ==============================

def ct_expand(seed):

    debug(f"Running CT expansion for {seed}")  # DEBUG

    brand = extract_brand(seed)

    try:

        url = f"https://crt.sh/?q=%25{brand}%25&output=json"

        r = requests.get(url, timeout=20)

        if r.status_code != 200:
            return

        data = r.json()

        for entry in data:

            name_value = entry.get("name_value","")

            for d in name_value.split("\n"):

                d = normalize_domain(d.lstrip("*."))

                if brand in d:
                    add_domain(d,"brand_ct",seed)

        debug(f"CT expansion completed for {seed}")  # DEBUG

    except Exception as e:

        debug(f"CT expansion failed for {seed} | {e}")  # DEBUG


# ==============================
# DNS RESOLUTION
# ==============================

def resolve_ip(domain):

    try:
        return socket.gethostbyname(domain)
    except:
        return ""


def reverse_dns(ip):

    try:
        return socket.gethostbyaddr(ip)[0]
    except:
        return "N/A"


# ==============================
# HTTP PROBING
# ==============================

def http_probe(domain):

    for scheme in ["https","http"]:

        url = f"{scheme}://{domain}"

        try:

            r = requests.get(
                url,
                timeout=TIMEOUT,
                allow_redirects=True,
                verify=False
            )

            title = ""

            m = re.search(
                r"<title[^>]*>(.*?)</title>",
                r.text,
                re.IGNORECASE | re.DOTALL
            )

            if m:
                title = re.sub(r"\s+"," ",m.group(1)).strip()

            return {
                "http_status": r.status_code,
                "http_reason": r.reason,
                "final_url": str(r.url),
                "final_status": r.status_code,
                "title": title
            }

        except:
            continue

    return None


# ==============================
# KNOWN DOMAIN CHECK
# ==============================

def load_known():

    known = set()

    if not os.path.exists(KNOWN_DOMAINS_FILE):
        return known

    with open(KNOWN_DOMAINS_FILE) as f:

        reader = csv.DictReader(f)

        for row in reader:

            d = normalize_domain(row.get("Domains",""))

            if d:
                known.add(d)

    return known


# ==============================
# MAIN
# ==============================

def main(seed_file, deep, expand):

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    outdir = f"recon_{timestamp}"
    os.makedirs(outdir, exist_ok=True)

    print("[+] Loading seed domains")

    seeds = []

    with open(seed_file) as f:

        for line in f:
            s = normalize_domain(line)
            if s:
                seeds.append(s)

    for seed in seeds:

        print(f"\n[+] Processing seed: {seed}")

        run_subdomain_enum(seed, deep)

        if expand:
            brand_expand(seed)
            ct_expand(seed)

    print(f"\n[+] Total domains discovered: {len(domain_registry)}")

    print("\n[+] Discovery source summary\n")

    for src, count in sorted(source_stats.items(), key=lambda x: x[1], reverse=True):
        print(f"{src:15} : {count}")

    all_domains_file = os.path.join(outdir,"all_domains.txt")

    with open(all_domains_file,"w") as f:

        for d in sorted(domain_registry.keys()):
            f.write(d+"\n")

    print("[+] Resolving IPs")
    
    domains = list(domain_registry.keys())
    total = len(domains)
    
    def resolve_domain(domain):
    
        ip = resolve_ip(domain)
    
        if ip:
            rdns = reverse_dns(ip)
        else:
            rdns = "N/A"
    
        return domain, ip, rdns
    
    
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as exe:
    
        futures = {exe.submit(resolve_domain, d): d for d in domains}
    
        completed = 0
    
        for f in as_completed(futures):
    
            completed += 1
    
            if completed % 500 == 0:
                debug(f"IP resolution progress: {completed}/{total}")
    
            domain, ip, rdns = f.result()
    
            domain_registry[domain]["ip"] = ip
            domain_registry[domain]["reverse_dns"] = rdns

    print("[+] HTTP probing")

    domains_with_ip = [
        d for d in domain_registry if domain_registry[d]["ip"]
    ]

    debug(f"Starting HTTP probing for {len(domains_with_ip)} domains")  # DEBUG

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as exe:

        futures = {
            exe.submit(http_probe,d): d
            for d in domains_with_ip
        }

        completed = 0  # DEBUG

        for f in as_completed(futures):

            completed += 1  # DEBUG

            if completed % 200 == 0:  # DEBUG
                debug(f"HTTP probes completed: {completed}/{len(domains_with_ip)}")  # DEBUG

            d = futures[f]
            r = f.result()

            if r:

                domain_registry[d]["http_status"] = r["http_status"]
                domain_registry[d]["http_reason"] = r["http_reason"]
                domain_registry[d]["final_url"] = r["final_url"]
                domain_registry[d]["final_status"] = r["final_status"]
                domain_registry[d]["title"] = r["title"]

    known = load_known()

    print("[+] Writing final CSV")

    csv_file = os.path.join(outdir,"final_output.csv")

    fields = [
        "Domain","Source","Seed","IP","Reverse_DNS",
        "HTTP_Status","HTTP_Reason","Redirect_Location",
        "Final_URL","Final_Status","Title","Domain_Status"
    ]

    with open(csv_file,"w",newline="",encoding="utf-8") as f:

        writer = csv.DictWriter(f,fieldnames=fields)

        writer.writeheader()

        for d,data in sorted(domain_registry.items()):

            writer.writerow({
                "Domain": d,
                "Source": ",".join(sorted(data["sources"])),
                "Seed": ",".join(sorted(data["seeds"])),
                "IP": data["ip"],
                "Reverse_DNS": data["reverse_dns"],
                "HTTP_Status": data["http_status"],
                "HTTP_Reason": data["http_reason"],
                "Redirect_Location": data["redirect_location"],
                "Final_URL": data["final_url"],
                "Final_Status": data["final_status"],
                "Title": data["title"],
                "Domain_Status": "Known" if d in known else "New"
            })

    print(f"[+] Done. Output saved in {outdir}")


if __name__ == "__main__":

    parser = argparse.ArgumentParser()

    parser.add_argument("seed_file")

    parser.add_argument("--deep", action="store_true")

    parser.add_argument("--expand", action="store_true")

    args = parser.parse_args()

    main(args.seed_file, args.deep, args.expand)
